# =============================================================================
# Absconding Detection System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (Development - Default)
DATABASE_URL=sqlite:///absconding.db

# PostgreSQL (Production - Recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/absconding_db

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-in-production

# Flask environment (development/production)
FLASK_ENV=development

# =============================================================================
# AI/ML SERVICES
# =============================================================================

# --- Anthropic Claude AI ---
# Get your API key from: https://console.anthropic.com/
# Required for RAG (Retrieval Augmented Generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- ChromaDB Cloud (Vector Database) ---
# Get credentials from: https://www.trychroma.com/
# Required for semantic search and RAG
CHROMA_API_KEY=your-chroma-api-key-here
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=absconding-detection-system

# ChromaDB Local (Alternative - no API key needed)
# Uncomment to use local ChromaDB instead of cloud
# CHROMA_LOCAL=true
# CHROMA_PERSIST_DIRECTORY=./chroma_db

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================

# --- Slack Integration (Optional) ---
# Create a Slack App: https://api.slack.com/apps
# Required OAuth Scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# --- Email Notifications (Optional) ---

# Gmail Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
# For Gmail: Use App Password (not your Gmail password)
# Generate at: Google Account > Security > 2-Step Verification > App Passwords
SENDER_PASSWORD=your-gmail-app-password
HR_TEAM_EMAILS=hr@company.com,manager@company.com

# Outlook/Office 365 Configuration (Alternative)
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@outlook.com
# SENDER_PASSWORD=your-outlook-password
# HR_TEAM_EMAILS=hr@company.com,manager@company.com

# Custom SMTP Server (Alternative)
# SMTP_SERVER=mail.yourcompany.com
# SMTP_PORT=587
# SENDER_EMAIL=noreply@yourcompany.com
# SENDER_PASSWORD=your-smtp-password
# HR_TEAM_EMAILS=hr@company.com,manager@company.com

# =============================================================================
# n8n WORKFLOW AUTOMATION (Optional)
# =============================================================================
# n8n runs in Docker - see docker-compose.yml
# These are for webhook security
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=securepassword123

# Webhook signature secret for security
WEBHOOK_SECRET=n8n_webhook_secret_key_change_this

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/absconding_system.log

# --- Performance Monitoring ---
# SENTRY_DSN=your-sentry-dsn-here

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================

# Enable HTTPS redirect in production
# FORCE_HTTPS=true

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourfrontend.com

# Rate Limiting
# RATE_LIMIT=100 per hour

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable specific features
ENABLE_RAG=true
ENABLE_SLACK_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_MCP_SERVER=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug mode (NEVER enable in production!)
DEBUG=false

# Mock external services for testing
MOCK_ANTHROPIC=false
MOCK_CHROMA=false
MOCK_SLACK=true
MOCK_EMAIL=true

# =============================================================================
# NOTES
# =============================================================================
# 
# Quick Setup Guide:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. At minimum, set: ANTHROPIC_API_KEY, CHROMA credentials
# 4. Optionally configure: Slack, Email notifications
# 5. Never commit .env to git (it's in .gitignore)
#
# Required Services:
# - Anthropic API: https://console.anthropic.com/
# - ChromaDB Cloud: https://www.trychroma.com/
#
# Optional Services:
# - Slack: https://api.slack.com/apps
# - Gmail: Use App Passwords (not account password!)
#
# Security:
# - Use strong SECRET_KEY in production
# - Enable HTTPS in production
# - Rotate API keys regularly
# - Never share .env file
#
# =============================================================================
